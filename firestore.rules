/**
 * @fileoverview Firestore Security Rules for Career360 Platform
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for personal data stored under `/users/{userId}` and its subcollections.
 * Administrative privileges are granted based on the existence of a document in the `/roles_admin/{userId}` collection.
 * Data validation is minimized for prototyping, focusing on authorization and relational integrity only.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data, accessible only to the user themselves.
 * - /users/{userId}/testResults/{testResultId}: Stores test results, accessible only to the user.
 * - /users/{userId}/chatMessages/{chatSessionId}/messages/{chatMessageId}: Stores chat messages, accessible only to the user.
 * - /users/{userId}/resumeAnalysis/{resumeAnalysisId}: Stores resume analysis results, accessible only to the user.
 * - /adminSettings/{settingsId}: Stores global admin settings, accessible only to admins. The `settingsId` must be `system`.
 * - /roles_admin/{userId}: Indicates admin status.  The presence of a document grants admin rights.
 *
 * Key Security Decisions:
 * - User data is strictly private, accessible only to the authenticated user.
 * - Admin privileges are managed through the presence of documents in `/roles_admin/{userId}`.
 * - Data validation is relaxed to facilitate rapid prototyping. Only ownership and relational integrity are validated.
 * - List operations are generally allowed for owners of user-scoped data, but prohibited for the `/roles_admin` collection.
 *
 * Denormalization for Authorization:
 * - Admin status is determined by the existence of a document in the `/roles_admin/{userId}` collection, avoiding complex queries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the current user is signed in.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @returns {boolean} True if the user is the owner, false otherwise.
     * @example isOwner('someUserId')
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the resource and the resource exists.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @returns {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
    
    /**
     * @description Checks if the current user is an admin based on document presence in /roles_admin/{userId}.
     * @returns {boolean} True if the user has admin privileges, false otherwise.
     */
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * @description Rules for user profile data.
     * @path /users/{userId}
     * @allow (create) Signed-in user creates their own profile: request.auth.uid == userId.
     * @allow (get, update, delete) Signed-in user accesses their own profile: request.auth.uid == userId.
     * @deny (create) Non-signed-in user attempts to create a profile.
     * @deny (get, update, delete) Signed-in user attempts to access another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for test results under a user's profile.
     * @path /users/{userId}/testResults/{testResultId}
     * @allow (create) Signed-in user creates a test result for themselves.
     * @allow (get, update, delete) Signed-in user accesses their own test results.
     * @deny (create) Non-signed-in user or another user attempts to create a test result.
     * @deny (get, update, delete) Signed-in user attempts to access another user's test results.
     * @principle Enforces hierarchical ownership for test results.
     */
    match /users/{userId}/testResults/{testResultId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for chat messages within a user's chat session.
     * @path /users/{userId}/chatMessages/{chatSessionId}/messages/{chatMessageId}
     * @allow (create) Signed-in user creates a chat message in their own session.
     * @allow (get, update, delete) Signed-in user accesses their own chat messages.
     * @deny (create) Non-signed-in user or another user attempts to create a chat message.
     * @deny (get, update, delete) Signed-in user attempts to access another user's chat messages.
     * @principle Enforces hierarchical ownership for chat messages.
     */
    match /users/{userId}/chatMessages/{chatSessionId}/messages/{chatMessageId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for resume analysis results under a user's profile.
     * @path /users/{userId}/resumeAnalysis/{resumeAnalysisId}
     * @allow (create) Signed-in user creates resume analysis result for themselves.
     * @allow (get, update, delete) Signed-in user accesses their own resume analysis results.
     * @deny (create) Non-signed-in user or another user attempts to create a resume analysis result.
     * @deny (get, update, delete) Signed-in user attempts to access another user's resume analysis results.
     * @principle Enforces hierarchical ownership for resume analysis data.
     */
    match /users/{userId}/resumeAnalysis/{resumeAnalysisId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for admin settings.
     * @path /adminSettings/{settingsId}
     * @allow (get, update) Admin can read and update settings.
     * @deny (create, delete) No one can create or delete settings. Settings are managed by the system.
     * @deny (get, update) Non-admin attempts to read or update settings.
     * @principle Restricts access to admin settings to authorized users only.
     */
    match /adminSettings/{settingsId} {
      allow get: if isAdmin() && settingsId == 'system';
      allow list: if false;
      allow create: if false;
      allow update: if isAdmin() && settingsId == 'system';
      allow delete: if false;
    }
    
    /**
     * @description Rules for admin roles. The existence of a document in this collection grants admin rights.
     * @path /roles_admin/{userId}
     * @allow (create) Only admins can grant other users admin access.
     * @allow (delete) Only admins can revoke admin access.
     * @deny (get, list, update) No one can get, list or update admin roles.
     * @principle Restricts modification of admin roles to existing admins.
     */
     match /roles_admin/{userId} {
        allow get: if false;
        allow list: if false;
        allow create: if isAdmin();
        allow update: if false;
        allow delete: if isAdmin();
     }
  }
}